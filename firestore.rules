rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True only if the CALLER's own user doc already has role == "admin".
    // This is the load-bearing check for every admin-only rule below —
    // nobody can grant themselves admin, because writes to `role` are
    // only allowed when this function is already true (see /users below).
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- users/{uid} ----
    // - Anyone signed in can read/create their OWN doc (created right
    //   after signup by the client, always with role: "customer").
    // - Admins can read/update ANY user doc (for the balance/role admin UI).
    // - A non-admin can update their own doc, but never the role or
    //   balance fields — those only change via an admin write.
    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.role == 'customer'
        && request.resource.data.balance == 0;

      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.balance == resource.data.balance);

      allow delete: if isAdmin();
    }

    // ---- carts/{uid} ----
    // Each signed-in shopper's saved cart, keyed by their own uid.
    // Only that user can ever read or write it — carts aren't visible
    // to other users, and there's no signed-out access since a guest
    // cart never leaves the browser.
    match /carts/{uid} {
      allow read, write: if isSelf(uid);
    }

    // ---- orders/{orderId} ----
    // Order history, written server-side by the checkout/payment
    // webhook using the Admin SDK once a payment actually completes
    // (Admin SDK writes bypass these rules entirely, same as how
    // products/categories get seeded). From the client, a signed-in
    // shopper can only read their OWN orders (matched by the `uid`
    // field on the order doc); admins can read and manage any order.
    // No client-side create/update/delete — that's intentionally left
    // to the trusted server process and to admins for corrections.
    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---- products/{productId} ----
    // Public read (storefront works for signed-out visitors too).
    // Only admins can create/update/delete products.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- categories/{categoryId} ----
    // Public read (nav bar renders for signed-out visitors too).
    // Only admins can create/update/delete categories.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- content/{docId} ----
    // Editable site copy: content/about, content/contact, content/footer.
    // Public read, admin-only write.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
